<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.ProtocolAi</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Self-defining integer-backed protocol vocabularies for compact, structured AI interaction.</Description>
    <PackageTags>AI;LLM;protocol;lexicon;integer;structured-output;TheSingularityWorkshop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.ProtocolAi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.ProtocolAi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Initial alpha: self-defining protocol vocabularies, integer references, mixed integer/literal payloads, and deterministic protocol descriptions.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Compile Remove="examples\**" />
    <None Remove="examples\**" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="docs\images\" />
  </ItemGroup>
</Project>
