<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.ProtocolAi</PackageId>
    <Version>0.1.0-alpha.3</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Deterministic, integer-backed semantic vocabularies for software built to interact with LLMs.</Description>
    <PackageTags>AI;LLM;protocol;lexicon;integer;structured-output;TheSingularityWorkshop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.ProtocolAi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.ProtocolAi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Alpha 3: add dependency-free JSON wire transport for protocol payloads.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Compile Remove="examples\**" />
    <None Remove="examples\**" />
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Update="docs\**\*.md" Pack="true" PackagePath="docs/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Update="docs\images\**\*" Pack="true" PackagePath="docs/images/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="docs\images\" />
  </ItemGroup>
</Project>
